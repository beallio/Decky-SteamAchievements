# direnv: keep all build scratch and package caches under /tmp/<project>, not in the repo.
export TMPDIR=/tmp/Decky-SteamAchievements
export XDG_CACHE_HOME=/tmp/Decky-SteamAchievements/.cache
# node/pnpm package cache -> /tmp so installed packages never land in the repo tree
export npm_config_cache=/tmp/Decky-SteamAchievements/.npm
export PYTHONPYCACHEPREFIX=/tmp/Decky-SteamAchievements/__pycache__
