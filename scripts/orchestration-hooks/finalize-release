#!/usr/bin/env bash
# Project release handoff. Invoked after orchestration merges the reviewed branch.
# This hook only prints the human runbook; it never pushes, invokes gh, or dispatches
# a workflow.
set -euo pipefail

version="${1:-}"
target="${version:-X.Y.Z}"

cat <<EOF
finalize-release: reviewed implementation merged locally; no remote action was taken.

Human release runbook: docs/runbooks/release.md

  1. Curate and validate CHANGELOG.md for $target.
  2. Deliberately merge dev into main at the human release gate.
  3. On clean main, run: scripts/release.sh $target
  4. Review the local tag and package, then run the two push commands it prints.
  5. Return to dev, run scripts/bump_next_patch.sh, commit all three metadata
     files together, and push dev to refresh the rolling dev-build prerelease.

Removing ORCH_LOCAL_ONLY alone performs none of those remote or release steps.
EOF

exit 0
